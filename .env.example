# =========================================================================
# AEGIS-AGENT Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local credentials.
# NEVER commit .env to source control or disclose your API keys.
# =========================================================================

# HTTP Server Configuration
PORT=3000
APP_URL=http://localhost:3000
APP_ENV=development

# PostgreSQL Database Configuration
# Supports local PostgreSQL, Supabase, Neon, or Railway PostgreSQL connection strings:
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/aegis_agent

# OpenRouter AI API Configuration
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Recommended models: openai/gpt-4o-mini, google/gemini-2.5-flash, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=google/gemini-2.5-flash

